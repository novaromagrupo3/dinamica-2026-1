                <rect x="140" y="82" width="32" height="32" rx="7" fill="#1388b3" />
                <rect x="140" y="124" width="32" height="32" rx="7" fill="#0d5570" />

                <!-- Center/Right Graphic Element -->
                <path d="M 184,82 H 230 C 235,82 238,85 238,90 V 151 C 238,153 236,156 234,156 H 184 Z" fill="#0d5570" opacity="0.15" />
                <path d="M 184,54 H 220 C 224,54 226,56 226,60 V 82 H 184 Z" fill="#1388b3" />
                <path d="M 184,82 H 238 V 110 H 184 Z" fill="#1fa89c" />
